# Virtual Environment
.venv/
env/
venv/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Data and Databases
# Excluding large database and CSV files
data/*.db
data/CSVs/*.csv

# Logs
logs/
*.log

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# IDE Settings
.idea/
.vscode/

# OS Files
.DS_Store
Thumbs.db

# NOTE: The 'models/' directories are EXPLICITLY ALLOWED to be tracked 
# across all project subdirectories for deployment.
!**/models/
!**/models/*.pkl
!**/models/*.joblib
